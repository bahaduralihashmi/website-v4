# Firebase remains the primary free cloud database for products, website reviews and admin data.
# Keep your existing Firebase configuration/secrets unchanged.

# Google Places API (New) - used server-side by Vercel to load current Google reviews.
# Do NOT expose GOOGLE_PLACES_API_KEY in client-side VITE_* variables.
GOOGLE_PLACES_API_KEY="YOUR_GOOGLE_PLACES_API_KEY"
GOOGLE_PLACE_ID="YOUR_GOOGLE_PLACE_ID"

# Existing AI Studio configuration (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://haidertrading.com"
